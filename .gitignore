# scripts/install_sharpa_wave_assets.py reproduces the ignored content
# below bit-for-bit from the pinned upstream commit (verified: see
# docs/history/PHASE4_GRASP_SESSION_35.md).
/assets/robots/sharpa_wave/left_sharpa_wave
/assets/robots/sharpa_wave/right_sharpa_wave

